<Page x:Class="WpfApp1.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Регистрация"
                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Email:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="txtbxLog" Grid.Row="1" Grid.Column="1" Width="220" Height="30" HorizontalAlignment="Left"/>

        <Label Grid.Row="2" Grid.Column="0" Content="ФИО:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="txtbxFIO" Grid.Row="2" Grid.Column="1" Width="220" Height="30" HorizontalAlignment="Left"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Пароль:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <PasswordBox x:Name="passBxFrst" Grid.Row="3" Grid.Column="1" Width="220" Height="30" HorizontalAlignment="Left"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Повторите пароль:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <PasswordBox x:Name="passBxScnd" Grid.Row="4" Grid.Column="1" Width="220" Height="30" HorizontalAlignment="Left"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Роль:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="comboBox" Grid.Row="5" Grid.Column="1" Width="220" Height="30" HorizontalAlignment="Left">
            <ComboBoxItem Content="READER"/>
            <ComboBoxItem Content="WRITER"/>
            <ComboBoxItem Content="ADMIN"/>
        </ComboBox>

        <Button x:Name="regButton" Grid.Row="6" Grid.Column="1" Content="Зарегистрироваться"
                Width="180" Height="35" HorizontalAlignment="Left" Click="regButton_Click"/>
    </Grid>
</Page>