<Page x:Class="WpfApp1.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Панель администратора" FontSize="24" Foreground="DarkRed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Таблица статей" Width="250" Height="40" Margin="10" Click="BtnArticles_Click"/>
            <Button Content="Таблица пользователей" Width="250" Height="40" Margin="10" Click="BtnUsers_Click"/>
            <Button Content="Таблица категорий" Width="250" Height="40" Margin="10" Click="BtnCategories_Click"/>
            <Button Content="Выйти" Width="250" Height="40" Margin="10,30,10,10" Click="Logout_Click"/>
        </StackPanel>
    </Grid>
</Page>