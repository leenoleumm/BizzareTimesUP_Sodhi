<Page x:Class="WpfApp1.Pages.ArticlesTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление статьями">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGridArticles" Grid.Row="0" Margin="10"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="120"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding User.Name}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Добавить" Width="120" Height="35" Margin="10" Click="ButtonAdd_Click"/>
            <Button Content="Удалить" Width="120" Height="35" Margin="10" Click="ButtonDel_Click"/>
            <Button Content="Редактировать" Width="120" Height="35" Margin="10" Click="ButtonEdit_Click"/>
        </StackPanel>
    </Grid>
</Page>