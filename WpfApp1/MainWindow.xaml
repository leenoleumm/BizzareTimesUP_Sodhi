<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bizzare Times" Height="600" Width="900"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Кнопка Назад -->
        <Button Content="Назад" Width="80" Height="30"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="10,0,0,0" Click="BtnBack_Click"/>

        <!-- Фрейм для страниц (сюда будем загружать Авторизацию) -->
        <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Source="Pages/AuthPage.xaml"/>

        <!-- Текущее время -->
        <TextBlock x:Name="DateTimeNow" Grid.Row="2"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,15,0" FontSize="14" Foreground="Gray"/>
    </Grid>
</Window>